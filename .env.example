# ============================================================================
# PC Agent - переменные окружения (шаблон)
# ----------------------------------------------------------------------------
# Скопируйте файл в .env и впишите свой ключ:
#   copy .env.example .env
# Файл .env не попадает в git (см. .gitignore) - ключ не утечёт.
# Переменные окружения приоритетнее значений из config.yaml.
#
# КЛИЕНТ УНИВЕРСАЛЬНЫЙ: подойдёт ключ любого из девяти провайдеров.
# Провайдер определяется по префиксу ключа, модель подбирается сама -
# вписывать адрес API и название модели не нужно.
# ============================================================================

# --- вариант 1: универсальная переменная (рекомендуется) -------------------
# Работает с ключом любого провайдера и не привязывает .env к одному вендору.
# Примеры префиксов: AIza... (Google), sk-proj-... ([OI]), sk-ant-... (Anthropic),
# sk-or-v1-... (OpenRouter), gsk_... (Groq), sk-cvc-... (AI Keys For You).
PCAGENT_API_KEY=ваш_ключ

# --- вариант 2: официальный ключ Google ------------------------------------
# Ключ из Google AI Studio: https://aistudio.google.com/apikey (начинается с AIza).
# Официальный API: данные идут напрямую в Google, посредников нет.
# GEMINI_API_KEY=AIzaSy...ваш_ключ

# --- вариант 3: ключ посредника или другого провайдера ---------------------
# ВНИМАНИЕ: посредник (шлюз) видит текст задач, снимки экрана и сам ключ.
# Клиент предупредит об этом в чате и в консоли. Для личных данных лучше
# официальный ключ.
# OPENROUTER_API_KEY=sk-or-v1-...ваш_ключ

# --- принимаемые имена переменных (порядок поиска) -------------------------
#   PCAGENT_API_KEY        универсальное имя, ищется первым
#   GEMINI_API_KEY         Google AI Studio
#   GOOGLE_API_KEY         Google (альтернативное имя)
#   GOOGLE_GENAI_API_KEY   Google (альтернативное имя)
#   OPENAI_API_KEY         [OI]
#   ANTHROPIC_API_KEY      Anthropic Claude
#   OPENROUTER_API_KEY     OpenRouter (посредник)
#   DEEPSEEK_API_KEY       DeepSeek
#   GROQ_API_KEY           Groq
#   MISTRAL_API_KEY        Mistral
#   TOGETHER_API_KEY       Together AI
# Достаточно одной строки - первой найденной.

# --- необязательно ---------------------------------------------------------
# Модель: перекрывает model из config.yaml. По умолчанию там "auto" -
# модель подбирается под провайдера ключа. Указывать имя модели нужно,
# только если хотите конкретную.
# PCAGENT_MODEL=auto

# Режим "ничего не выполнять" (1/true/yes/on)
# PCAGENT_DRY_RUN=0

# Не читать файл .env (1 - отключить; полезно для тестов)
# PCAGENT_NO_ENV=0
